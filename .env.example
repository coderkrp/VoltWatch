# VoltWatch - Example Environment Variables
# Copy this file to .env or export these in your shell

# ==========================================
# BACKEND SETTINGS
# ==========================================
# DATABASE_URL=sqlite:///./data_logger.db
# SESSION_TIMEOUT_SECONDS=60
# MAX_ABS_VOLTAGE=1000.0
# MAX_ABS_CURRENT=100000.0

# Security (Set REQUIRE_API_KEY=true in production)
# REQUIRE_API_KEY=false
# API_KEY=change_this_to_a_secure_random_string

# Server config
# HOST=0.0.0.0
# PORT=8000
# UVICORN_RELOAD=false

# ==========================================
# DASHBOARD SETTINGS
# ==========================================
# BACKEND_API_URL=http://localhost:8000/api/v1
# BACKEND_API_KEY=change_this_to_match_backend_if_auth_enabled
